# ── Server ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/splitwise_db"

# ── Auth (we skip real JWT for now, user_id comes in request) ──
JWT_SECRET="your_super_secret_key_here"
