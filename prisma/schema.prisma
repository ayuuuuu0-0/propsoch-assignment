generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  currency  String   @default("USD")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expensesCreated Expense[]       @relation("ExpenseCreator")
  expenseMembers  ExpenseMember[]

  @@map("users")
}

model Expense {
  id        String   @id @default(uuid())
  name      String
  value     Decimal  @db.Decimal(10, 2)
  currency  String
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String  @map("created_by")
  createdBy   User    @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Cascade)

  members ExpenseMember[]

  @@map("expenses")
}

// join table — tracks who is in an expense and how much they owe
model ExpenseMember {
  id        String  @id @default(uuid())
  share     Decimal @db.Decimal(10, 2)

  expenseId String  @map("expense_id")
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@map("expense_members")
}
